# AutoHub Assistant - settings used by every script.
# EDIT the first block, leave the rest alone.

export AWS_REGION="ap-southeast-2"          # Sydney - the only region this account plan allows. One region (brief 1.3).
export ALERT_EMAIL="rjoshuapogi27@gmail.com"   # your real inbox - alarms and budget emails go here
export MONTHLY_BUDGET_USD="10"               # budget alert threshold
export GEMINI_MODEL="gemini-3.5-flash"       # gemini-2.5-flash is retired for new keys (HTTP 404)
export INSTANCE_TYPE="t3.small"              # 2 GB, free-tier eligible (plan blocks t3.medium); 2 GB swap + RAG off

# ---- derived values, do not edit ----
export AWS_DEFAULT_REGION="$AWS_REGION"
export NAME="autohub"
export PARAM_PREFIX="/autohub"
export ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"
export BUCKET="${NAME}-content-${ACCOUNT_ID}-${AWS_REGION}"
export TRAIL_BUCKET="${NAME}-trail-${ACCOUNT_ID}-${AWS_REGION}"
export STATE_FILE="$HOME/autohub-state.env"
touch "$STATE_FILE"
# shellcheck disable=SC1090
source "$STATE_FILE"

if [[ "$ALERT_EMAIL" == CHANGE-ME* ]]; then
  echo "Edit config.env first: set ALERT_EMAIL to your real inbox." >&2
  exit 1
fi

save_state() {  # save_state KEY VALUE  -> remembered between scripts in $STATE_FILE
  sed -i "/^$1=/d" "$STATE_FILE"
  echo "$1=\"$2\"" >> "$STATE_FILE"
  export "$1=$2"
}

say() { echo -e "\n== $*"; }

# Run a create command; treat "already exists" as success so scripts can be re-run safely.
try() {
  local out
  if out=$("$@" 2>&1); then
    echo "   ok"
  elif grep -qiE 'exist|duplicate|already|InUse' <<<"$out"; then
    echo "   already there (ok)"
  else
    echo "$out" >&2
    return 1
  fi
}
