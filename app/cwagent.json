{
  "agent": {
    "metrics_collection_interval": 60
  },
  "metrics": {
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "aggregation_dimensions": [
      [
        "InstanceId"
      ]
    ],
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent"
        ]
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "resources": [
          "/"
        ],
        "drop_device": true
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/autohub/LibreChat/logs/*.log",
            "log_group_name": "/autohub/app",
            "log_stream_name": "{instance_id}-librechat",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/autohub/requests.log",
            "log_group_name": "/autohub/app",
            "log_stream_name": "{instance_id}-requests",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/autohub/healthcheck.log",
            "log_group_name": "/autohub/automation",
            "log_stream_name": "{instance_id}-healthcheck",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/autohub/backup.log",
            "log_group_name": "/autohub/automation",
            "log_stream_name": "{instance_id}-backup",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/autohub/restore.log",
            "log_group_name": "/autohub/automation",
            "log_stream_name": "{instance_id}-restore",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/autohub/deploy.log",
            "log_group_name": "/autohub/deploy",
            "log_stream_name": "{instance_id}-deploy",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/autohub-bootstrap.log",
            "log_group_name": "/autohub/deploy",
            "log_stream_name": "{instance_id}-bootstrap",
            "retention_in_days": 14
          }
        ]
      }
    }
  }
}